# IMO3D environment reference — all values intentionally blank.
# Do NOT load this whole file or overwrite existing private env files. Optional/OS blanks can break defaults.
# Select only needed settings into a protected local file; no NEXT_PUBLIC_ secrets.
# Gemini has NO environment API-key variable: use the masked Windows DPAPI setup UI.

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
APPDATA=

# Optional Codex config/generated-images root for legacy photo editing; user-specific, not a secret-export mechanism.
CODEX_HOME=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
COMSPEC=

# Local Hugging Face artifact cache root; assigned by room runtime.
HF_HOME=

# Disable model-library telemetry in workers.
HF_HUB_DISABLE_TELEMETRY=

# Disable network model fetch during inference.
HF_HUB_OFFLINE=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
HOME=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
HOMEDRIVE=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
HOMEPATH=

# Private initial/local administrator secret; at least32 characters. Cloud password may later be stored as a hash in the database.
IMO3D_ADMIN_SECRET=

# Private evidence/model inference cache directory; generally set per job by worker.
IMO3D_ANALYSIS_CACHE_DIR=

# Optional Next build output directory, default .next; must match selected dev/build type paths.
IMO3D_BUILD_DIR=

# Select Supabase adapter with1; otherwise local SQLite. Choose deliberately; cloud mode accesses real data.
IMO3D_CLOUD=

# Expected dedicated Supabase project reference; worker isolation guard.
IMO3D_CLOUD_PROJECT_REF=

# Optional Codex executable path for existing photo-retouch/legacy executor, not Gemini API transport.
IMO3D_CODEX_BIN=

# Python native scientific-package target path; overrides ignored runtime JSON.
IMO3D_CV_PATH=

# Private persistent local SQLite/assets directory; not used as cloud production persistence.
IMO3D_DATA_DIR=

# Optional private local-development tour fixture path; disabled in production.
IMO3D_EXAMPLE_FILE=

# Local Horizon/layout Python package target override.
IMO3D_LAYOUT_PACKAGES=

# Local layout weight file path override.
IMO3D_LAYOUT_WEIGHTS=

# Expected pinned layout weight hash; do not change merely to accept unverified weights.
IMO3D_LAYOUT_WEIGHTS_SHA256=

# Local RT-DETR object detector model directory override.
IMO3D_OBJECT_MODEL_DIR=

# Local photo-depth model directory override.
IMO3D_PHOTO_DEPTH_MODEL_DIR=

# Canonical permitted public origin for auth/CSRF/integration redirects; use separate local override for localhost.
IMO3D_PUBLIC_ORIGIN=

# Absolute Python interpreter path on this machine; overrides ignored runtime JSON.
IMO3D_PYTHON=

# Room inference device selection, normally auto; CPU/CUDA choice must match actual installed runtime.
IMO3D_ROOM_DEVICE=

# Private signing secret for cloud admin sessions and ChatGPT authorization; keep stable during transfer.
IMO3D_SESSION_SECRET=

# Test-only switch to skip private apartment fixtures.
IMO3D_SKIP_PRIVATE_FIXTURES=

# Test-only path to a private reference drawing.
IMO3D_TEST_PRIVATE_DRAWING_FILE=

# Test-only path to private reference geometry.
IMO3D_TEST_PRIVATE_EXAMPLE_FILE=

# Local PyTorch package target override.
IMO3D_TORCH_PATH=

# Local vision/ONNX Python package target override.
IMO3D_VISION_PATH=

# Local room-analysis visual-language model directory override.
IMO3D_VLM_MODEL_DIR=

# Local visual-language Python package target override.
IMO3D_VLM_PATH=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
LANG=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
LC_ALL=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
LOCALAPPDATA=

# Managed by Next/Node tooling; development or production mode. Do not set globally.
NODE_ENV=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
NUMBER_OF_PROCESSORS=

# Native CPU thread bound for reconstruction.
OMP_NUM_THREADS=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
OneDrive=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
OneDriveCommercial=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
OneDriveConsumer=

# Optional legacy LOCAL OpenAI plan pipeline key. Not needed for current CLOUD Gemini plan provider.
OPENAI_API_KEY=

# BLAS CPU thread bound for reconstruction.
OPENBLAS_NUM_THREADS=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
OS=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
PATH=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
PATHEXT=

# Suppress pip version checks during explicit model setup.
PIP_DISABLE_PIP_VERSION_CHECK=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
PROCESSOR_ARCHITECTURE=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
ProgramFiles=

# Disable .pyc generation for inference/preflight.
PYTHONDONTWRITEBYTECODE=

# Worker Python pipe encoding.
PYTHONIOENCODING=

# Worker UTF-8 mode for Python subprocesses.
PYTHONUTF8=

# Private DB administration/migration password present in local deployment env; not required by normal REST viewer.
SUPABASE_DATABASE_PASSWORD=

# Private server/worker Supabase service credential; NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated Supabase project HTTPS URL, server/worker only.
SUPABASE_URL=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
SystemRoot=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
TEMP=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
TMP=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
TMPDIR=

# Disable implicit Transformers model downloads during inference.
TRANSFORMERS_OFFLINE=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
USERDOMAIN=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
USERNAME=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
USERPROFILE=

# Provided by Vercel runtime; used to disable private local fixtures.
VERCEL=

# Vercel-provided expiring authentication value; do not copy into source or rely on migration.
VERCEL_OIDC_TOKEN=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
WINDIR=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
XDG_CACHE_HOME=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
XDG_CONFIG_HOME=

# Operating-system/tool-provided environment or inherited subprocess setting; normally leave unset in app env and inherit from the host.
XDG_DATA_HOME=
